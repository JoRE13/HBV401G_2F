    AIRPORTS {
        VARCHAR airport_code PK
        VARCHAR name
        VARCHAR city
        VARCHAR country
    }

    FLIGHTS {
        VARCHAR flight_number PK
        TIMESTAMPTZ departure_at
        TIMESTAMPTZ arrival_at
        INTEGER duration_minutes
        NUMERIC base_price
