        INTEGER capacity
        VARCHAR departure_airport_code FK
        VARCHAR arrival_airport_code FK
        VARCHAR airplane_type
    }

    PASSENGERS {
        VARCHAR email PK
        VARCHAR full_name
        VARCHAR phone
        VARCHAR nationality
        DATE date_of_birth
    }

    RESERVATIONS {
        VARCHAR reservation_code PK
        TIMESTAMPTZ created_at
        VARCHAR status
        NUMERIC total_price
    }

    RESERVATION_ITEMS {
        VARCHAR item_id PK
        VARCHAR reservation_code FK
        VARCHAR passenger_email FK
        NUMERIC price_paid
    }

    RESERVATION_FLIGHTS {
        VARCHAR reservation_code PK,FK
        VARCHAR flight_number PK,FK
    }

    RESERVATION_ITEM_FLIGHTS {
        VARCHAR item_id PK,FK
        VARCHAR flight_number PK,FK
        VARCHAR seat_id
    }

    AIRPORTS ||--o{ FLIGHTS : "departure_airport_code"
    AIRPORTS ||--o{ FLIGHTS : "arrival_airport_code"

    RESERVATIONS ||--o{ RESERVATION_ITEMS : has
